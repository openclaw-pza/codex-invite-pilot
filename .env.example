# ---- Cloudflare 临时无限邮箱 (cloudflare_temp_email) ----
# 后台地址，不含 /admin。示例：https://mail.your-domain.com
MAIL_BASE_URL=
# 后台 admin 鉴权，对应请求头 x-admin-auth
MAIL_ADMIN_AUTH=
# 收件域名（生成邮箱用）。多个用逗号分隔，默认取第一个。示例：your-domain.com
MAIL_DOMAIN=

# ---- HeroSMS 接码平台 ----
HERO_SMS_API_KEY=
HERO_SMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
# 服务码：dr = OpenAI
HERO_SMS_SERVICE=dr
# 国家 ID：52 = 泰国(+66)
HERO_SMS_COUNTRY=52
# 运营商，any = 不限
HERO_SMS_OPERATOR=any
# 拿号优先级：price = 低价优先(先查价从最便宜档取号) / country = 直接取号
HERO_SMS_PRIORITY=price
# 单次取号最高可接受价格（留空=不限；低价优先时作为价格上限）
HERO_SMS_MAX_PRICE=

# ---- 站点地址 ----
# 发货文案里给买家的地址。不配 = 用 https://example.com（买家会拿到无效地址）。
# 部署到公网前必须配成你自己的域名。
SITE_URL=

# ---- 本地服务 ----
PORT=8787

# ---- 意见反馈发信（QQ 邮箱自发自收）----
# 收发用同一个 QQ 邮箱：QQ 内部投递 100% 进收件箱。
# 换成自有域名发信会被 QQ 当陌生域名过滤（.xyz + 没配 DMARC），进垃圾箱等于没收到。
# FEEDBACK_SMTP_PASS 是 QQ 邮箱的 16 位**授权码**，不是 QQ 登录密码。
# 这几个不配 = 反馈功能只落库不发信（不会报错，日志里会说）。
FEEDBACK_SMTP_HOST=smtp.qq.com
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_TO=

# ---- 支付宝当面付 / 网站支付（自动到账）----
# 这几个不配齐 = 补差价走「扫码 + 备注 + 卖家人工核对」那条路（功能不受影响）。
# 配到一半也算没配 —— 半套配置只会让买家点了付款拿到空链接，比没这个按钮更糟。
# ALIPAY_APP_PRIVATE_KEY 是**我们自己的应用私钥**，ALIPAY_PUBLIC_KEY 是**支付宝的公钥**，
# 两个别搞反：搞反了签名发不出去、验签全过不了，而报错看不出是哪一头。
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# ⚠ 必须换成你自己的域名。照抄别人的地址 = 你的支付回调打到别人服务器上，
# 而且这个错不会报错，只会表现成「买家付了钱但订单一直不到账」。
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=

# ---- 项目署名（Apache-2.0 要求保留）----
# 页面底部会带一行「Powered by codex-invite-pilot」。
# 设成 off / 0 / false 可以关掉，**关掉之后代码照常运行** ——
# 这里没有任何「检测到署名被移除就罢工」的逻辑，也不会有。
BRANDING_FOOTER=
# 署名链接指向哪。留空 = 项目仓库地址。
BRANDING_URL=

# ---- 顶栏 GitHub star 按钮（可选，默认不显示）----
# 填 owner/name 才会出现，比如 openclaw-pza/codex-invite-pilot。
# 留空 = 顶栏没有这个按钮。
#
# 为什么默认关：页脚那行署名是许可证要求的，顶栏这个是推广位。
# 你部署这套代码去卖自己的东西，不该被默认塞一个指向别人仓库的按钮。
# fork 之后可以指向你自己的仓库。
GITHUB_REPO=
# star 数缓存时长（毫秒），默认 30 分钟。
# 请求走服务端发出，所有访客共用一个出口 IP，而 GitHub 匿名接口是每小时 60 次 ——
# 调太小会撞限流，表现是按钮永远没有数字，而且查不出为什么。
GITHUB_STARS_TTL_MS=
